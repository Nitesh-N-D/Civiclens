# Copy to .env for local development. Keep secrets out of Git and browser code.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Model configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENABLE_EMBEDDINGS=false

# Global backend quota limits (both keys share one free-tier project pool).
# When reached, answers fall back to cited search-only mode instead of failing.
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_DAILY_REQUEST_LIMIT=100

# Per-visitor limits on /api/ask; excess requests get 429 with Retry-After.
# If Gemini quota runs out: lower CLIENT_DAILY_REQUEST_LIMIT to 25-30.
# If many visitors arrive at once: lower CLIENT_REQUESTS_PER_MINUTE to 2-3.
CLIENT_REQUESTS_PER_MINUTE=5
CLIENT_DAILY_REQUEST_LIMIT=40

# Network and access control
# Production (Render): ALLOWED_ORIGINS=https://civiclens.nitesh-viva-ai.workers.dev
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set true only behind a reverse proxy you control (e.g. Render), never when exposed directly.
TRUST_FORWARDED_FOR=false

# Optional local maintainer token: opens the overview as 'viewer' only (it can never change
# anything). Do not set it on public hosting; use Supabase sign-in below instead.
CIVICLENS_ADMIN_TOKEN=

# Optional PostgreSQL (Supabase). Leave empty to run without a database; the API still answers.
# When set, the shared daily Gemini budget survives restarts (Render free sleeps when idle).
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543, IPv4-compatible), e.g.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Never add the service_role/secret key anywhere. RLS (migrations 0003, 0005) blocks the public Data API.
# Apply migrations once from backend/:  python scripts/migrate.py
DATABASE_URL=

# Optional maintainer sign-in through Supabase Auth (needs DATABASE_URL and migration 0005).
# Dashboard -> Project Settings -> API Keys: the project URL and the PUBLISHABLE key
# (sb_publishable_... or the legacy anon key). Both are public by design: /api/health hands them
# to the maintainer page. Turn off public sign-up, add users in the dashboard, then grant a role:
#   python scripts/grant_role.py someone@example.org reviewer
# See docs/guides/ADMIN_GUIDE.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
