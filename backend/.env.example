# Copy to .env for local development. Keep secrets out of Git and browser code.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Model configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENABLE_EMBEDDINGS=false

# Global backend quota limits (both keys share one free-tier project pool).
# When reached, answers fall back to cited search-only mode instead of failing.
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_DAILY_REQUEST_LIMIT=100

# Per-visitor limits on /api/ask; excess requests get 429 with Retry-After.
# If Gemini quota runs out: lower CLIENT_DAILY_REQUEST_LIMIT to 25-30.
# If many visitors arrive at once: lower CLIENT_REQUESTS_PER_MINUTE to 2-3.
CLIENT_REQUESTS_PER_MINUTE=5
CLIENT_DAILY_REQUEST_LIMIT=40

# Network and access control
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set true only behind a reverse proxy you control (e.g. Render), never when exposed directly.
TRUST_FORWARDED_FOR=false

# Optional read-only local maintainer overview token. Do not enable on public hosting.
CIVICLENS_ADMIN_TOKEN=
